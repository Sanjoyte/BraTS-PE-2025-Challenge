# ---------------------------------------------------------------------------
# Machine-specific configuration. Copy to `.env` and edit; `.env` is gitignored.
#
#   cp .env.example .env
#
# Every path must be ABSOLUTE. On WSL2 keep these inside the native Linux
# filesystem (e.g. /home/<you>/...), NOT under /mnt/c/... — cross-filesystem
# I/O there is several times slower and will bottleneck preprocessing.
# ---------------------------------------------------------------------------

# Root of this repository.
PEDS_ROOT="/home/youruser/BraTS2025-PEDS"

# Raw challenge data, holding Training/ and Validation/ case folders.
PEDS_RAW_DATASET="${PEDS_ROOT}/raw_dataset/BraTS-PEDs-v1"

# ---------------------------------------------------------------------------
# Working root. Lives inside the repo, and is gitignored (see .gitignore:
# `peds_work/`) — so nothing here is ever committed, but the project stays
# self-contained. It grows large: ~18 GB preprocessed for the full 257-case
# dataset, more once checkpoints and predictions accumulate. Make sure the
# disk holding the repo has room, or point PEDS_WORK at another disk instead.
# Pull finished artifacts from the shared Drive rather than recomputing them.
# ---------------------------------------------------------------------------
PEDS_WORK="${PEDS_ROOT}/peds_work"

# The three directories nnU-Net v2 requires.
nnUNet_raw="${PEDS_WORK}/nnUNet_raw"
nnUNet_preprocessed="${PEDS_WORK}/nnUNet_preprocessed"
nnUNet_results="${PEDS_WORK}/nnUNet_results"

# HFF-Net working dir: frequency-decomposed volumes + train/val split lists.
PEDS_HFF_DATA="${PEDS_WORK}/hff_data"
PEDS_HFF_RESULTS="${PEDS_WORK}/hff_results"

# Where inference writes predictions.
PEDS_PREDICTIONS="${PEDS_WORK}/predictions"

# ---------------------------------------------------------------------------
# nnU-Net dataset identity. 501 is this project's BraTS-PED conversion.
# ---------------------------------------------------------------------------
PEDS_DATASET_ID="501"
PEDS_DATASET_NAME="Dataset501_BraTSPED"

# ---------------------------------------------------------------------------
# Hardware / method hyperparameters
# ---------------------------------------------------------------------------
# GPU ids visible to training, comma separated (e.g. "0" or "0,1").
CUDA_VISIBLE_DEVICES="0"


# Disable torch.compile; it is fragile on very new GPU architectures.
nnUNet_compile="false"

# The authors' adjustable initialization scale (their contribution #1).
# Weights are drawn from N(0, fan_in^(-gamma)). Their submission used 0.7.
# Leave empty ("") to keep nnU-Net's stock initialization.
PEDS_GAMMA="0.7"

# Trainer classes for each ensemble member.
PEDS_NNUNET_TRAINER="nnUNetTrainer_1000epochs"
PEDS_SWIN_TRAINER="nnUNetTrainer_Swinunetr_1005epochs"

# Swin UNETR transfer learning: path to the BraTS 2021 pre-trained checkpoint.
# Download from the MONAI SwinUNETR/BRATS21 model zoo (see run_commands.md).
# Leave empty to train Swin UNETR from random initialization.
PEDS_SWIN_PRETRAINED=""

# MATLAB executable, used only for the HFF high-frequency (NSCT) step.
PEDS_MATLAB="matlab"

# ---------------------------------------------------------------------------
# Memory safety (16 GB machine)
# ---------------------------------------------------------------------------
# nnU-Net sizes its worker pools from the CPU count by default (12 dataloader
# workers and 8 general workers here), and each worker holds full 3D patches in
# RAM. On a 16 GB box that overshoots and the machine locks up, so both pools
# are pinned low. Raise them only on a machine with more RAM.
nnUNet_n_proc_DA="2"
nnUNet_def_n_proc="2"

# Keep BLAS single-threaded; nnU-Net does its own parallelism and nested thread
# pools waste memory as well as CPU.
OMP_NUM_THREADS="1"
MKL_NUM_THREADS="1"
OPENBLAS_NUM_THREADS="1"

# Hard ceiling enforced by scripts/capped.sh (systemd cgroup). A job that
# exceeds this is killed on its own instead of freezing the desktop.
PEDS_MEM_MAX="11G"
PEDS_SWAP_MAX="2G"

# Worker counts for the CLI stages, referenced throughout run_commands.md.
PEDS_NP_PREPROCESS="2"
PEDS_NP_PREDICT="1"
